  recipeList:
  - Name: Hamburger
    Content: "Ingredients: \n- Pain\n- Steak \n- Fromage \n- Salade/tomate/oignions\n\r\nInstructions:
      \n- Mettre de le pain, le fromage, la salade et les tomates\n- Cuire le steak
      et les oignons \n- Assembler le tout "
  - Name: Salade
    Content: "Ingredients: \n- Salade\n- Melon \n- Tomate \n- Concombre\n- Aubergine\n\r\nInstructions:
      \n- Melanger le tout dans un saladier"
  - Name: 'Pop Corn '
    Content: "Ingredients: \n- Ma\xEFs\n\nInstructions: \n- Faire cuire le ma\xEFs\n-
      Mettre le pop corn dans un bol ou un saladier"
  - Name: '"Fish and Chips"'
    Content: "Ingredients: \n- Frite\n- Poisson \n\nInstructions: \n- Faire cuire
      les deux ingredients\n- Ajouter le tout ensemble"
  - Name: Hot Dog
    Content: "Ingredients: \n- Pain\n- Saucisse \n- Fromage \n\nInstructions: \n-
      Cuire la saucisse\n- Ajouter tout dans le pain "
